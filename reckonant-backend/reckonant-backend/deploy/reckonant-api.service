[Unit]
Description=Reckonant data API (Python)
After=network.target

[Service]
User=reckonant
Group=reckonant
WorkingDirectory=/opt/reckonant-backend/reckonant_backend
EnvironmentFile=/etc/reckonant-api.env
ExecStart=/opt/reckonant-backend/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
