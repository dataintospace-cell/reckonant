[Unit]
Description=Reckonant Python dashboard (Streamlit, internal)
After=reckonant-api.service

[Service]
User=reckonant
Group=reckonant
WorkingDirectory=/opt/reckonant-backend/reckonant_backend
Environment=RK_API_URL=http://127.0.0.1:8000
Environment=HOME=/tmp
ExecStart=/opt/reckonant-backend/venv/bin/streamlit run dashboard.py --server.address 127.0.0.1 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=3
PrivateTmp=true

[Install]
WantedBy=multi-user.target
