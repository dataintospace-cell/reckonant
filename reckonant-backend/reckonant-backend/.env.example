# Copy to /etc/reckonant-api.env (chmod 600) and fill in.
# Read-only login to the Signals Feeder Engine database:
RK_DATABASE_URL=postgresql://reckonant_ro:CHANGE_ME@127.0.0.1:5432/postgres
# Optional:
# RK_REGISTERS=CQC-02,CON-01,FTS-01      # only companies on these registers (default: everything in the company master)
# RK_MAX_COMPANIES=5000                  # the app is built for up to about 5,000 companies
# RK_LOOKBACK_DAYS=365                   # how far back signals go
# RK_REFRESH_MINUTES=60                  # how often the API re-reads the database
# RK_REFRESH_TOKEN=long-random-string    # lets you force a rebuild: POST /api/refresh with header X-Refresh-Token
